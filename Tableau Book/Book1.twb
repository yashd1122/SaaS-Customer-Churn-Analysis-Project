      <aliases enabled='yes' />
      <column caption='Churn Rate %' datatype='real' name='[Calculation_1078893649656619008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([churn_flag]) * 100' />
      </column>
      <column caption='Active MRR' datatype='integer' name='[Calculation_1078893649657061377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [churn_flag] = 0 THEN [mrr_amount] ELSE 0 END)' />
      </column>
      <column caption='ARR at Risk' datatype='integer' name='[Calculation_1078893649657335810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [churn_flag] = 1 THEN [mrr_amount] ELSE 0 END) * 12' />
      </column>
      <column caption='Revenue Lost' datatype='integer' name='[Calculation_1078893649679360003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [churn_flag] = 1 THEN [mrr_amount] ELSE 0 END)' />
      </column>
      <column caption='Tenure Bucket' datatype='string' name='[Calculation_593067839938834433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure_months] &lt; 3 THEN &quot;0-3 months&quot;&#13;&#10;ELSEIF [tenure_months] &lt; 6 THEN &quot;3-6 months&quot;&#13;&#10;ELSE &quot;6+ months&quot;&#13;&#10;END' />
      </column>
      <column caption='Tenure Order' datatype='integer' name='[Calculation_593067839944339458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_593067839938834433]&#13;&#10;  WHEN &quot;0-3 months&quot; THEN 1&#13;&#10;  WHEN &quot;3-6 months&quot; THEN 2&#13;&#10;  WHEN &quot;6+ months&quot; THEN 3&#13;&#10;  ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Churn Flag (Readable)' datatype='string' name='[Calculation_593067839968587779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_flag] = 1 THEN &quot;Churned&quot; &#13;&#10;ELSE &quot;Active&quot; &#13;&#10;END' />
      </column>
